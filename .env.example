# ===============================
# Pulse.ai – shared config
# Copy to .env and fill in. Used by Express, optional for Python (see config.py).
# ===============================

# ----- Backend (Express) -----
PORT=5000
NODE_ENV=development
PROM_URL=http://localhost:9090/api/v1/query

# ----- Frontend (React) – only when not using proxy -----
# REACT_APP_API_URL=http://localhost:5000

# ----- InfluxDB (used by Python scripts, Telegraf, and Docker init) -----
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=pulse-ai-secure-token
INFLUX_ORG=pulse-ai
INFLUX_BUCKET=metrics

# ----- Prometheus (for Python collector / Streamlit when not in Docker) -----
PROMETHEUS_URL=http://localhost:9090

# ----- Optional: Grafana (for embedding) -----
# GRAFANA_URL=http://localhost:3000
# GRAFANA_DASHBOARD_UID=rYdddlPWk
