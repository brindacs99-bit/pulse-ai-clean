# Pulse.ai – Express + React full-stack (with optional Python forecast)
FROM node:20-bookworm-slim

WORKDIR /app

# Install Python for /forecast (model_predict.py)
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages numpy joblib

# Backend (install root deps; frontend build uses root's npm run build)
COPY package*.json package-lock.json* server.js ./
RUN npm ci --omit=dev

# Frontend
COPY frontend/package*.json frontend/
RUN cd frontend && npm ci
COPY frontend/ ./frontend/
RUN npm run build

# Python forecast script + config (same config as rest of stack)
COPY model_predict.py ./
COPY src/ ./src/

# Optional: mount ./models at runtime for forecast
ENV NODE_ENV=production
ENV PORT=5000
EXPOSE 5000

CMD ["node", "server.js"]
